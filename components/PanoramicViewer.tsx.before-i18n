'use client'

import { useRef, useState } from 'react'

export default function PanoramicViewer({
  src,
  alt,
}: {
  src: string
  alt: string
}) {
  const ref = useRef<HTMLDivElement>(null)
  const [dragging, setDragging] = useState(false)
  const [startX, setStartX] = useState(0)
  const [startScroll, setStartScroll] = useState(0)
  const [explored, setExplored] = useState(false)

  const startDrag = (clientX: number) => {
    if (!ref.current) return
    setDragging(true)
    setExplored(true)
    setStartX(clientX)
    setStartScroll(ref.current.scrollLeft)
  }

  const drag = (clientX: number) => {
    if (!dragging || !ref.current) return
    ref.current.scrollLeft = startScroll - (clientX - startX)
  }

  return (
    <div className="relative left-1/2 w-screen -translate-x-1/2">
      <div
        ref={ref}
        className={`panorama-viewer overflow-x-auto overflow-y-hidden ${
          dragging ? 'cursor-grabbing' : 'cursor-grab'
        }`}
        onMouseDown={(e) => startDrag(e.clientX)}
        onMouseMove={(e) => drag(e.clientX)}
        onMouseUp={() => setDragging(false)}
        onMouseLeave={() => setDragging(false)}
        onTouchStart={() => setExplored(true)}
      >
        <img
          src={src}
          alt={alt}
          draggable={false}
          className="block h-[78vh] max-w-none select-none object-contain"
        />
      </div>

      {!explored && (
        <div className="pointer-events-none absolute bottom-5 right-6 text-[11px] uppercase tracking-[0.14em] text-[#0F02E6]">
          Drag to explore →
        </div>
      )}

      <style jsx>{`
        .panorama-viewer {
          scrollbar-width: none;
          -ms-overflow-style: none;
        }

        .panorama-viewer::-webkit-scrollbar {
          display: none;
        }
      `}</style>
    </div>
  )
}
